{
  "build": {
    "preview": {
      "channel": "preview",
      "environment": "preview",
      "android": {
        "gradleCommand": ":app:assembleRelease",
        "buildType": "apk"
      },
      "distribution": "internal"
    },
    "development": {
      "developmentClient": true,
      "environment": "development",
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "buildType": "apk"
      },
      "channel": "development",
      "distribution": "internal"
    },
    "production": {
      "channel": "production",
      "environment": "production"
    }
  }
}
